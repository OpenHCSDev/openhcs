digraph OpenHCS {
  graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5,
         fontname="Helvetica", fontsize=18,
         label="A shared microscopy workflow for scientists and agents", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=14,
        margin="0.18,0.12", color="#52616B", fillcolor="#F4F7F9", penwidth=1.2];
  edge [fontname="Helvetica", fontsize=12, color="#52616B", arrowsize=0.7];

  data [label="Microscopy images\nAcquisition folders, Bio-Formats,\nOMERO and OME-Zarr", fillcolor="#EAF2FA"];
  functions [label="Analysis functions\nCellProfiler pipelines\nand Python functions", fillcolor="#FFF1E4"];
  interface [label="Author and revise\nDesktop editor | Python | MCP", fillcolor="#E8F3ED"];
  {rank=same; data; functions;}

  workflow [label="One editable pipeline\nImage mappings + processing steps\nParameters + output destinations", fillcolor="#DCEFEB", color="#247566", penwidth=2];
  compile [label="Check and prepare\nResolve inputs, dependencies\nand execution requirements"];
  execute [label="Run across samples\nSeparate execution processes\nProgress and saved outputs", fillcolor="#EAF2FA"];
  review [label="Inspect intermediate results\nImages, labels and ROIs\nin napari or Fiji", fillcolor="#FFF1E4"];
  results [label="Reuse and report\nMeasurement tables, saved images\nand editable pipeline code", fillcolor="#E8F3ED"];

  data -> workflow [label="map images"];
  functions -> workflow [label="select or import"];
  interface -> workflow [dir=both, label="inspect / edit"];
  workflow -> compile;
  compile -> execute;
  execute -> review [label="stream"];
  execute -> results [label="save"];
  review -> interface [label="refine analysis", style=dashed, constraint=false];
  {rank=same; review; results;}
}
