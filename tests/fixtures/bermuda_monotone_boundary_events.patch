 impl MonotonePolygonBuilder {
+    /// Close pieces at the current boundary event before continuing that side.
+    /// A later event cannot close them without crossing the intervening boundary.
+    fn finish_polygons_on_side(&mut self, interval: &mut Interval, p: Point, right_side: bool) {
+        if interval.polygons_list.len() <= 1 {
+            return;
+        }
+        if right_side {
+            for mut polygon in interval.polygons_list.drain(1..) {
+                polygon.bottom = Some(p);
+                self.monotone_polygons.push(polygon);
+            }
+        } else {
+            let retained = interval.polygons_list.pop().unwrap();
+            for mut polygon in interval.polygons_list.drain(..) {
+                polygon.bottom = Some(p);
+                self.monotone_polygons.push(polygon);
+            }
+            interval.polygons_list.push(retained);
+        }
+    }
