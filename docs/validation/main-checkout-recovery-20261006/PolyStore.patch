+def test_roi_zip_parent_label_selection_retains_complete_parent_only(tmp_path):
+    pytest.importorskip("roifile")
+    path = tmp_path / "labels.roi.zip"
+    polygon = np.array([[10, 20], [10, 22], [12, 22], [12, 20]], dtype=float)
+    rois = [
+        ROI(
+            shapes=[PolygonShape(polygon), PolygonShape(polygon + 5)],
+            metadata={"label": 7, "source_spatial_shape_yx": (100, 200)},
+        ),
+        ROI(
+            shapes=[PolygonShape(polygon + 10)],
+            metadata={"label": 8, "source_spatial_shape_yx": (100, 200)},
+        ),
+    ]
+    DiskStorageBackend()._save_rois(rois, path)
+
+    assert len(load_rois_from_zip(path)) == 3
+    selected = load_rois_from_zip(
+        path,
+        selection=ROIArchiveParentLabelSelection((7,)),
+    )
+    assert len(selected) == 2
+    assert {roi.metadata["label"] for roi in selected} == {7}
+    backend_selected = DiskStorageBackend().load(
+        path,
+        selection=ROIArchiveParentLabelSelection((7,)),
+    )
+    assert len(backend_selected) == 2
+    assert {roi.metadata["label"] for roi in backend_selected} == {7}
+    with pytest.raises(ValueError, match="max_members"):
+        load_rois_from_zip(
+            path,
+            selection=ROIArchiveParentLabelSelection((7,), max_members=1),
+        )
+    with pytest.raises(ValueError, match="No valid ROIs"):
+        load_rois_from_zip(
+            path,
+            selection=ROIArchiveParentLabelSelection((9,)),
+        )
+
+
+def test_roi_archive_parent_label_selection_rejects_invalid_bounds():
+    with pytest.raises(ValueError, match="positive integers"):
+        ROIArchiveParentLabelSelection((True,))
+    with pytest.raises(ValueError, match="unique"):
+        ROIArchiveParentLabelSelection((7, 7))
+    with pytest.raises(ValueError, match="positive integer"):
+        ROIArchiveParentLabelSelection((7,), max_members=0)
+
+
