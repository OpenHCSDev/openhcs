+@dataclass(frozen=True, slots=True)
+class ROIArchiveParentLabelSelection:
+    """Bound an ImageJ ROI archive read to complete parent-label projections."""
+
+    labels: tuple[int, ...]
+    max_members: int = 5000
+
+    def __post_init__(self) -> None:
+        if not self.labels:
+            raise ValueError("Select at least one parent ROI label.")
+        if any(type(label) is not int or label <= 0 for label in self.labels):
+            raise ValueError("Parent ROI labels must be positive integers.")
+        if len(set(self.labels)) != len(self.labels):
+            raise ValueError("Parent ROI labels must be unique.")
+        object.__setattr__(self, "labels", tuple(sorted(self.labels)))
+        if type(self.max_members) is not int or self.max_members <= 0:
+            raise ValueError("max_members must be a positive integer.")
+
